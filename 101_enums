#flag works like enum , but allows us to combine constants.
from enum import Flag

class ColorFlag(Flag):
    RED = 1
    GREEN = 2
    BLUE = 4
    YELLOW = 8
    BLACK = 16
# why using powers of two , it prevents the combination of values to form an existing value from our enum.

cool_colors: ColorFlag = ColorFlag.RED | ColorFlag.YELLOW | ColorFlag.BLACK    # Pipe = union operator
my_car_color: ColorFlag = ColorFlag.BLACK

if my_car_color in cool_colors:
    print("You have a cool car!")
else:
    print("Sorry, your car isn't cool.")
