# Enums, example 1 
from enum import Enum

class Color(Enum):   # define class Color and inherit from Enum
    RED = 'R'
    BLUE = 'B'
    GREEN = 'G'

class Status(Enum):   # define class Color and inherit from Enum
    IDLE = 0
    IN_PROGRESS= 1
    STOPPED = 2
    ERROR = 3


print(Color.RED)
print(Color.GREEN)
print(Color.BLUE)
print(Color("R"))
print(repr(Color.RED))

print(Status(3))
print(Status.IDLE)

def create_car(color: Color) -> None:
    match color:
        case Color.RED:
            print(f"you've created a red car")
        case Color.BLUE:
            print(f"you've created a blue car")
        case Color.GREEN:
            print(f"you've created a green car")
        case _:
            print(f"invalid color {color}")

create_car('PURPLE') # our typechecker will warn about this. and so will our function: "invalid color PURPLE"
create_car(Color.RED) # unless we use colors from our Color Enum.

